{
  "name": "@tinydialog/cli",
  "version": "0.0.1-rc.2",
  "description": "Read tinyDialog projects, surveys, and submitted feedback from the command line.",
  "type": "module",
  "repository": "https://github.com/tinyDialog/cli",
  "author": "tinydialog.com",
  "homepage": "https://tinydialog.com",
  "bugs": {
    "url": "https://github.com/tinyDialog/cli/issues"
  },
  "bin": {
    "tinydialog": "dist/npm/index.js"
  },
  "files": [
    "dist/npm",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./index.ts --target=node --outfile ./dist/npm/index.js",
    "build:standalone": "bun build ./index.ts --compile --minify --no-compile-autoload-dotenv --no-compile-autoload-bunfig",
    "prepack": "bun run build",
    "typecheck": "bun check --no-script",
    "lint": "bun --bun oxlint",
    "lint:fix": "bun --bun oxlint --fix",
    "format": "bun --bun oxfmt \"**/*.{js,mjs,cjs,ts,mts,cts}\"",
    "format:check": "bun run format --check",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "test": "bun test"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "0.78.0",
    "oxlint": "1.94.0",
    "tsrs": "7.1.0-beta.tsrs5"
  },
  "license": "MIT"
}
