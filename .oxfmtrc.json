{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 160,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "bracketSpacing": false,
  "arrowParens": "always",
  "quoteProps": "preserve",
  "embeddedLanguageFormatting": "off",
  "ignorePatterns": [
    "**/dist/**"
  ]
}
